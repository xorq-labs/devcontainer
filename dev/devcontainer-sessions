#!/usr/bin/env python3
"""Enumerate Claude Code sessions stored inside devcontainer per-container volumes.

Live transcripts are bound out to ~/.claude/projects/-devcontainer-<container>
(docker-compose.yml), so they survive `reset`/`clean` and are readable straight
from the host. Everything else in ~/.claude stays in the per-worktree
`<compose-project>_claude-home` volume, and transcripts written before that bind
existed are still in there -- `--migrate` lifts them out.

So this reads both sources, prefers the host copy where a session is in both, and
joins the result against `docker inspect` to recover the container name, state,
and host worktree. The volumes are root-owned, so that half of the scan runs
inside a throwaway container that bind-mounts this same file as its reader
(--reader); --host-only skips it and reads the host directories alone.

Usage:
    devcontainer-sessions                    # every project, newest first
    devcontainer-sessions -p xorq            # one project
    devcontainer-sessions -p xorq -n 10      # the 10 most recent
    devcontainer-sessions --all              # include host-seeded copies
    devcontainer-sessions --json             # machine-readable
    devcontainer-sessions --migrate          # lift pre-bind transcripts out of the volumes
    devcontainer-sessions --resume-on-host 5331ec2b   # file one under the host's own key
"""

import argparse
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

VOLUME_SUFFIX = "_claude-home"
# dev/devcontainer binds ~/.claude/projects/-devcontainer-<container-name> over
# the container's own project key, so live transcripts are readable right here.
HOST_LOG_PREFIX = "-devcontainer-"
CLAUDE_HOME = "/home/vscode/.claude"
READER_IMAGE = "mcr.microsoft.com/devcontainers/python:3.12-bookworm"
READER_ROOT = Path("/vols")
EXPORT_ROOT = Path("/out")
# Per-session state that sits beside the transcript, keyed by session id.
SIDECARS = ("tasks", "file-history", "session-env")


# ---------------------------------------------------------------- reader mode


def read_session(path):
    """Pull identity, last activity and opening prompt out of one transcript.

    Reads only the head and tail of the file: these grow to tens of MB and we
    need the first user turn and the final record, nothing in between.
    """
    stat = path.stat()
    session = {
        "path": str(path),
        "size": stat.st_size,
        "mtime": stat.st_mtime,
        "last_timestamp": None,
        "session_id": None,
        "cwd": None,
        "git_branch": None,
        "version": None,
        "summary": None,
        "sidechain": False,
        "records_tail": 0,
    }
    with path.open("rb") as fh:
        head = fh.read(1 << 18)
        fh.seek(max(0, stat.st_size - (1 << 20)))
        tail = fh.read()

    for line in head.split(b"\n"):
        record = load_record(line)
        if not record:
            continue
        session["session_id"] = session["session_id"] or record.get("sessionId")
        session["cwd"] = session["cwd"] or record.get("cwd")
        session["sidechain"] = session["sidechain"] or bool(record.get("isSidechain"))
        session["summary"] = session["summary"] or first_prompt(record)

    # Walk back to the last record that actually carries a timestamp: the final
    # line is often a bare summary or file-history entry with no clock on it.
    for line in reversed(tail.split(b"\n")):
        record = load_record(line)
        if not record:
            continue
        session["git_branch"] = session["git_branch"] or record.get("gitBranch")
        session["version"] = session["version"] or record.get("version")
        session["session_id"] = session["session_id"] or record.get("sessionId")
        session["cwd"] = session["cwd"] or record.get("cwd")
        if record.get("timestamp"):
            session["last_timestamp"] = record["timestamp"]
            break

    # Lines in the tail window only -- an exact count would mean reading the whole
    # file, which is the read this head/tail split exists to avoid. Exact for any
    # transcript that fits in the window, a floor for the ones that don't.
    session["records_tail"] = tail.count(b"\n")
    return session


def load_record(line):
    line = line.strip()
    if not line.startswith(b"{"):
        return None
    try:
        return json.loads(line)
    except (ValueError, UnicodeDecodeError):
        return None


def first_prompt(record):
    """The opening user turn, minus system-reminder and command-tag noise."""
    if record.get("type") == "summary" and record.get("summary"):
        return str(record["summary"])
    if record.get("type") != "user":
        return None
    content = (record.get("message") or {}).get("content")
    if isinstance(content, list):
        content = " ".join(block.get("text", "") for block in content if isinstance(block, dict))
    if not isinstance(content, str):
        return None
    text = re.sub(r"<[^>]+>.*?</[^>]+>", " ", content, flags=re.S)
    return re.sub(r"\s+", " ", text).strip() or None


def run_reader(root):
    """Walk every volume mounted under `root` and emit one JSON blob."""
    scanned = {}
    for volume in sorted(p for p in root.iterdir() if p.is_dir()):
        sessions = []
        for path in sorted((volume / "projects").rglob("*.jsonl")):
            try:
                sessions.append(read_session(path))
            except OSError:
                continue
        scanned[volume.name] = sessions
    json.dump(scanned, sys.stdout)


def run_export(root, out, session_id, src_prefix, dst_prefix):
    """Stage one session out of the single volume mounted under `root`.

    The transcript is rewritten container-path -> host-path, the exact inverse of
    the rewrite setup-claude does when it seeds transcripts in. Paths already
    written as host paths (DEV_MAIN_TREE is mounted at its host path inside the
    container, so they do occur) don't match the container prefix and pass
    through untouched.

    Sidecars are copied verbatim. file-history entries are named by an opaque
    hash, so their keys are left alone -- they come along for the record, not
    because a host-side lookup will find them.
    """
    staged = []
    for volume in sorted(p for p in root.iterdir() if p.is_dir()):
        for path in sorted((volume / "projects").rglob(f"{session_id}.jsonl")):
            text = path.read_text()
            (out / "transcript.jsonl").write_text(text.replace(src_prefix, dst_prefix))
            staged.append(str(path))
        for name in SIDECARS:
            sidecar = volume / name / session_id
            if sidecar.is_dir():
                shutil.copytree(sidecar, out / name, dirs_exist_ok=True)
                staged.append(str(sidecar))
    json.dump(staged, sys.stdout)


def run_dump(root, out):
    """Copy every transcript in the mounted volume out, skipping ones already there.

    Flattened: keys other than the bound-out one (sessions started in a nested
    in-container worktree) would otherwise have nowhere to go. Session ids are
    uuids, so flattening cannot collide.
    """
    copied = []
    for volume in sorted(p for p in root.iterdir() if p.is_dir()):
        for path in sorted((volume / "projects").rglob("*.jsonl")):
            destination = out / path.name
            if destination.exists():
                continue
            shutil.copy2(path, destination)
            copied.append(path.name)
    json.dump(copied, sys.stdout)


# ------------------------------------------------------------------ host mode


def docker(*args):
    try:
        return subprocess.run(["docker", *args], capture_output=True, text=True, check=True).stdout
    except FileNotFoundError:
        fail("docker not found on PATH")
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "").strip()
        fail(f"`docker {' '.join(args[:2])}` failed: {detail or exc}")


def sanitize(name):
    """Mirror of lib/git.sh sanitize_name(), which names every compose project."""
    name = re.sub(r"[^a-zA-Z0-9_-]+", "-", name).lower()
    return re.sub(r"^[^a-z0-9]*|[^a-z0-9]*$", "", name) or "project"


def collect_containers():
    """compose-project -> container facts, for running and stopped alike."""
    ids = docker("ps", "-aq").split()
    if not ids:
        return {}
    containers = {}
    for entry in json.loads(docker("inspect", *ids)):
        labels = (entry.get("Config") or {}).get("Labels") or {}
        project = labels.get("com.docker.compose.project")
        if not project:
            continue
        # DEV_WORKSPACE is bind-mounted at DEV_CONTAINER_WORKSPACE, which compose
        # also sets as the working_dir -- so the working_dir's bind source is the
        # host worktree, without having to re-read the project's env files.
        workdir = (entry.get("Config") or {}).get("WorkingDir")
        worktree = next(
            (
                mount["Source"]
                for mount in entry.get("Mounts") or []
                if mount.get("Type") == "bind" and mount.get("Destination") == workdir
            ),
            None,
        )
        containers[project] = {
            "container": entry["Name"].lstrip("/"),
            "state": entry["State"]["Status"],
            "worktree": worktree,
            "workspace": workdir,
        }
    return containers


def guess_worktree(slug, containers):
    """Recover the worktree of a volume whose container has been removed.

    A compose project is `<project>-dev-<basename(worktree)>` after sanitizing,
    and sanitizing is lossy (both `/` and `.` collapse to `-`), so match by
    re-sanitizing the directories sitting alongside the worktrees we do know.
    Returns None once the worktree itself is gone -- the volume outlives it.
    """
    if not slug:
        return None
    parents = {Path(facts["worktree"]).parent for facts in containers.values() if facts["worktree"]}
    for parent in sorted(parents):
        try:
            candidates = sorted(p for p in parent.iterdir() if p.is_dir())
        except OSError:
            continue
        for candidate in candidates:
            if sanitize(candidate.name) == slug:
                return str(candidate)
    return None


def scan_volumes(volumes, image):
    """Run this file inside a container that can actually read the volumes."""
    mounts = [arg for volume in volumes for arg in ("-v", f"{volume}:{READER_ROOT}/{volume}:ro")]
    return json.loads(
        docker(
            "run",
            "--rm",
            "--network",
            "none",
            "--user",
            "0",
            "-v",
            f"{Path(__file__).resolve()}:/reader.py:ro",
            *mounts,
            image,
            "python3",
            "/reader.py",
            "--reader",
        )
    )


def scan_host_logs(claude_home):
    """Read the bound-out log directories straight from the host -- no docker.

    Keyed like a volume scan so everything downstream is source-agnostic.
    """
    scanned = {}
    root = claude_home / "projects"
    if not root.is_dir():
        return scanned
    for directory in sorted(root.glob(f"{HOST_LOG_PREFIX}*")):
        if not directory.is_dir():
            continue
        compose_project = directory.name[len(HOST_LOG_PREFIX) :]
        sessions = []
        for path in sorted(directory.glob("*.jsonl")):
            try:
                session = read_session(path)
            except OSError:
                continue
            session["host"] = True
            sessions.append(session)
        scanned[f"{compose_project}{VOLUME_SUFFIX}"] = sessions
    return scanned


def merge_scans(*scans):
    merged = {}
    for scan in scans:
        for key, sessions in scan.items():
            merged.setdefault(key, []).extend(sessions)
    return merged


def volume_exists(name):
    # List and match rather than `inspect`: a missing volume makes `inspect`
    # exit non-zero, which docker() turns into a hard failure -- so a plain
    # "does it exist" check has to avoid provoking that.
    return name in docker("volume", "ls", "--format", "{{.Name}}").split()


def parse_timestamp(value):
    if not value:
        return None
    try:
        return datetime.datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def host_activity(session_ids, claude_home):
    """Last-activity of each host transcript that a container volume also holds.

    setup-claude seeds a fresh container by copying the host's transcripts in
    (seed_transcripts), keeping the file name -- so a shared session id means the
    container copy came from the host. Only if the container copy has advanced
    past the host's last record was that session actually worked on in there.
    """
    activity = {}
    for session_id in session_ids:
        for path in (claude_home / "projects").glob(f"*/{session_id}.jsonl"):
            # A bound-out log directory is the container's own storage, not a
            # host twin -- counting it would mark every live session as seeded.
            if path.parent.name.startswith(HOST_LOG_PREFIX):
                continue
            try:
                stamp = parse_timestamp(read_session(path)["last_timestamp"])
            except OSError:
                continue
            if stamp is not None:
                activity[session_id] = max(stamp, activity.get(session_id, stamp))
    return activity


def build_rows(scanned, containers, include_seeded, claude_home):
    ids = {s["session_id"] for v in scanned.values() for s in v if s["session_id"]}
    on_host = host_activity(ids, claude_home)
    rows = []
    for volume, sessions in scanned.items():
        compose_project = volume[: -len(VOLUME_SUFFIX)]
        project, _, _ = compose_project.partition("-dev-")
        _, _, slug = compose_project.rpartition("-dev-")
        facts = containers.get(compose_project, {})
        worktree = facts.get("worktree") or guess_worktree(slug, containers)
        for session in sessions:
            last = parse_timestamp(session["last_timestamp"])
            host_last = on_host.get(session["session_id"])
            seeded = host_last is not None and (last is None or last <= host_last)
            if seeded and not include_seeded:
                continue
            rows.append(
                {
                    "session_id": session["session_id"],
                    "project": project,
                    "compose_project": compose_project,
                    "volume": volume,
                    "container": facts.get("container"),
                    "state": facts.get("state", "removed"),
                    "worktree": worktree,
                    "worktree_slug": slug,
                    "worktree_checked": bool(containers),
                    "container_workspace": facts.get("workspace"),
                    "container_cwd": session["cwd"],
                    "git_branch": session["git_branch"],
                    "last_write": session["mtime"],
                    "last_activity": last,
                    "size": session["size"],
                    "records_tail": session["records_tail"],
                    "sidechain": session["sidechain"],
                    "seeded": seeded,
                    "host_path": session["path"] if session.get("host") else None,
                    "version": session["version"],
                    "summary": session["summary"],
                    "transcript": session["path"].replace(f"{READER_ROOT}/{volume}", CLAUDE_HOME),
                }
            )
    rows = dedupe(rows)
    # Sort after dedupe: which copy of a session wins is decided by host-residency
    # (below), not recency, so ordering the survivors is the last step.
    rows.sort(key=lambda row: row["last_activity"] or row["last_write"], reverse=True)
    return rows


def dedupe(rows):
    """One row per session id: the host-resident copy, else the most advanced.

    While a worktree is part-migrated its transcripts exist both in the volume
    (frozen at migration) and in the bound-out directory (live). Same session,
    two files; the host one is the one still being written, so it wins. Failing a
    host copy (e.g. the same id seeded into two volumes), the copy with the later
    last activity wins -- keeping select_session's "take the most advanced"
    contract true even though dedupe now collapses each id before it runs.
    """

    def rank(row):
        return (bool(row["host_path"]), row["last_activity"] or row["last_write"] or 0)

    best = {}
    for row in rows:
        key = row["session_id"]
        if key is None:
            best[row["transcript"]] = row
            continue
        rival = best.get(key)
        if rival is None or rank(row) > rank(rival):
            best[key] = row
    return list(best.values())


# ------------------------------------------------------------- resume on host


def host_project_key(worktree):
    """Claude Code keys a project directory by its cwd, non-alphanumerics -> '-'."""
    return re.sub(r"[^a-zA-Z0-9]", "-", worktree)


def is_live(row):
    """True while a container Claude still holds this session open.

    setup-claude symlinks ~/.claude/sessions into the worktree, so the host can
    see a per-pid stub for every session a running container started.
    """
    if row["state"] != "running" or not row["worktree"]:
        return False
    stubs = Path(row["worktree"]) / ".claude" / "container-sessions"
    for stub in stubs.glob("*.json"):
        try:
            with stub.open() as fh:
                if json.load(fh).get("sessionId") == row["session_id"]:
                    return True
        except (OSError, ValueError):
            continue
    return False


def stage_export(row, src_prefix, dst_prefix, out_dir, image):
    """Run the export half inside a container that can read the volume."""
    docker(
        "run",
        "--rm",
        "--network",
        "none",
        # As the invoking user, not root: the volume's files are already owned by
        # DEV_UID (= the host uid), and whatever we stage has to be ours to move.
        "--user",
        f"{os.getuid()}:{os.getgid()}",
        "-v",
        f"{Path(__file__).resolve()}:/reader.py:ro",
        "-v",
        f"{row['volume']}:{READER_ROOT}/{row['volume']}:ro",
        "-v",
        f"{out_dir}:{EXPORT_ROOT}",
        image,
        "python3",
        "/reader.py",
        "--export",
        row["session_id"],
        "--rewrite",
        src_prefix,
        dst_prefix,
    )


def resume_on_host(row, claude_home, image, force, dry_run, container_workspace, worktree_path, host_only):
    """Copy a container session onto the host so `claude --resume` can find it.

    Placement is a fast-forward, never a merge: a host twin only gets overwritten
    when the container copy is strictly ahead of it, because a twin that is ahead
    means the session was continued on the host after seeding and overwriting
    would destroy that work.
    """
    worktree = worktree_path or row["worktree"]
    if not worktree:
        fail(f"worktree for {row['compose_project']} is not on disk; say where to resume it with --worktree-path")
    # Resolve symlinks so the project key matches what `claude --resume` derives
    # from getcwd() (which is already canonical) once you cd into the worktree.
    worktree = str(Path(worktree).resolve())
    src_prefix = container_workspace or row["container_workspace"] or row["container_cwd"]
    if not src_prefix:
        fail("cannot tell which container path to rewrite; pass --container-workspace")
    if is_live(row) and not force:
        fail(f"session {row['session_id'][:8]} is open in {row['container']}; exit it first")

    key = host_project_key(worktree)
    destination = claude_home / "projects" / key / f"{row['session_id']}.jsonl"
    twin = destination.exists()
    if twin and not force:
        # Compare last records, not file size: rewriting the path prefix changes
        # the byte count, so the two copies never match on length. "Ahead" here
        # is a timestamp comparison, not an ancestry check -- if host and
        # container both advanced independently after seeding, a container that
        # merely has the newer last record still wins. The pre-write backup below
        # is what makes that safe.
        host_last = parse_timestamp(read_session(destination)["last_timestamp"])
        container_last = row["last_activity"]
        if host_last is not None and container_last is not None and host_last == container_last:
            print(f"host copy of {row['session_id'][:8]} is already at {fmt_time(host_last)} -- nothing to do")
            return 0
        if host_last is not None and (container_last is None or host_last > container_last):
            fail(
                f"the host copy of {row['session_id'][:8]} is ahead of the container's "
                f"({fmt_time(host_last)} vs {fmt_time(container_last)}), so it has records "
                "the container copy doesn't. Overwriting would lose them -- pass --force "
                "to do it anyway (the host copy is backed up either way)"
            )

    print(f"session   {row['session_id']}")
    print(f"from      {row['volume']}")
    print(f"rewrite   {src_prefix} -> {worktree}")
    print(f"into      {destination}")
    if dry_run:
        print("\n(dry run -- nothing written)")
        return 0

    with tempfile.TemporaryDirectory() as staging:
        staging = Path(staging)
        transcript = staging / "transcript.jsonl"
        # Sidecars stay inside claude-home even once transcripts are bound out,
        # so the volume is still where they come from -- when it still exists.
        # --host-only forgoes them rather than touch docker; a host_path copy is
        # enough for a resume, sidecars are the extra.
        if not host_only and volume_exists(row["volume"]):
            stage_export(row, src_prefix, worktree, staging, image)
        if row["host_path"]:
            text = Path(row["host_path"]).read_text()
            transcript.write_text(text.replace(src_prefix, worktree))
        if not transcript.is_file():
            fail(f"no transcript staged for {row['session_id']} (neither a host copy nor a readable volume)")

        if twin:
            backups = claude_home / "backups"
            backups.mkdir(parents=True, exist_ok=True)
            stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
            backup = backups / f"{row['session_id']}.jsonl.{stamp}"
            shutil.copy2(destination, backup)
            print(f"backed up host copy to {backup}")

        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(transcript), destination)
        for name in SIDECARS:
            staged = staging / name
            if staged.is_dir():
                shutil.copytree(staged, claude_home / name / row["session_id"], dirs_exist_ok=True)
                print(f"copied {name}/")

    print(f"\nresume it with:\n  cd {worktree} && claude --resume {row['session_id']}")
    return 0


def migrate(volumes, containers, claude_home, image, dry_run):
    """Lift transcripts out of each claude-home volume into its host log dir.

    For volumes predating the bind. Copy, not move: the volume copy is left in
    place as a fallback, and `dedupe` prefers the host one from then on.
    """
    total = 0
    for volume in volumes:
        compose_project = volume[: -len(VOLUME_SUFFIX)]
        destination = claude_home / "projects" / f"{HOST_LOG_PREFIX}{compose_project}"
        container = containers.get(compose_project, {}).get("container", compose_project)
        if dry_run:
            print(f"{container} -> {destination}")
            continue
        destination.mkdir(parents=True, exist_ok=True)
        copied = json.loads(
            docker(
                "run",
                "--rm",
                "--network",
                "none",
                "--user",
                f"{os.getuid()}:{os.getgid()}",
                "-v",
                f"{Path(__file__).resolve()}:/reader.py:ro",
                "-v",
                f"{volume}:{READER_ROOT}/{volume}:ro",
                "-v",
                f"{destination}:{EXPORT_ROOT}",
                image,
                "python3",
                "/reader.py",
                "--dump",
            )
        )
        total += len(copied)
        print(f"{container}: {len(copied)} transcript(s) -> {destination}")
    if not dry_run:
        print(f"\n{total} transcript(s) copied onto the host")
    return 0


def select_session(rows, wanted):
    matches = [row for row in rows if (row["session_id"] or "").startswith(wanted)]
    if not matches:
        fail(f"no session id starts with '{wanted}'")
    ids = {row["session_id"] for row in matches}
    if len(ids) > 1:
        shown = ", ".join(sorted(session_id[:8] for session_id in ids)[:5])
        fail(f"'{wanted}' matches {len(ids)} sessions ({shown}) -- be more specific")
    # dedupe already collapsed each id to its best copy (host, else most
    # advanced), and the guard above leaves exactly one id -- so one row remains.
    return matches[0]


def fail(message):
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(1)


# ---------------------------------------------------------------- table output


def fmt_time(epoch):
    if not epoch:
        return "-"
    return datetime.datetime.fromtimestamp(epoch).strftime("%Y-%m-%d %H:%M")


def fmt_size(size):
    for unit in ("B", "K", "M", "G"):
        if size < 1024 or unit == "G":
            return f"{size:.0f}{unit}" if unit == "B" else f"{size:.1f}{unit}"
        size /= 1024


def shorten(path, home):
    return f"~{path[len(home) :]}" if path.startswith(home) else path


def fmt_worktree(row, home):
    if row["worktree"]:
        return shorten(row["worktree"], home)
    # Without container data there is nothing to anchor the search on, so an
    # unresolved worktree means "not looked up", not "gone".
    return f"{row['worktree_slug']} ({'deleted' if row['worktree_checked'] else '?'})"


COLUMNS = (
    ("LAST WRITE", lambda row, home: fmt_time(row["last_activity"] or row["last_write"])),
    ("SESSION", lambda row, home: (row["session_id"] or "?")[:8]),
    ("WORKTREE", fmt_worktree),
    ("CONTAINER", lambda row, home: row["container"] or f"({row['compose_project']})"),
    ("STATE", lambda row, home: row["state"]),
    ("BRANCH", lambda row, home: row["git_branch"] or "-"),
    ("SIZE", lambda row, home: fmt_size(row["size"])),
    ("SUMMARY", lambda row, home: (row["summary"] or "-")[:64]),
)


def print_table(rows, home):
    table = [[header for header, _ in COLUMNS]]
    table += [[render(row, home) for _, render in COLUMNS] for row in rows]
    widths = [max(len(row[i]) for row in table) for i in range(len(COLUMNS))]
    for row in table:
        print("  ".join(cell.ljust(width) for cell, width in zip(row, widths, strict=True)).rstrip())


def parse_args():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--reader", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--export", metavar="SESSION", help=argparse.SUPPRESS)
    parser.add_argument("--dump", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--rewrite", nargs=2, metavar=("FROM", "TO"), help=argparse.SUPPRESS)
    parser.add_argument("-p", "--project", help="only this project, e.g. xorq")
    parser.add_argument("-w", "--worktree", help="only worktrees matching this substring")
    parser.add_argument("-n", "--limit", type=int, help="only the N most recent sessions")
    parser.add_argument(
        "--all",
        action="store_true",
        help="also show transcripts seeded in from the host at container create",
    )
    parser.add_argument("--sidechains", action="store_true", help="also show subagent sidechain sessions")
    parser.add_argument("--json", action="store_true", help="emit JSON instead of a table")
    parser.add_argument("--image", default=READER_IMAGE, help="image used to read volumes")
    parser.add_argument(
        "--resume-on-host",
        metavar="SESSION",
        help="copy a session (id or prefix) onto the host so `claude --resume` finds it",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="with --resume-on-host: overwrite a host copy that is ahead, or a live session",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="with --resume-on-host: report what would be copied and stop",
    )
    parser.add_argument(
        "--container-workspace",
        help="container path to rewrite to the worktree (default: the container's working_dir)",
    )
    parser.add_argument(
        "--worktree-path",
        help="worktree to resume against, for when the original is gone or has moved",
    )
    parser.add_argument(
        "--migrate",
        action="store_true",
        help="copy transcripts out of the claude-home volumes into their host log dirs",
    )
    parser.add_argument(
        "--host-only",
        action="store_true",
        help="read only the host log directories -- no docker, no container scan",
    )
    parser.add_argument(
        "--claude-home",
        type=Path,
        default=Path.home() / ".claude",
        help="host Claude directory to read and write (default: ~/.claude)",
    )
    return parser.parse_args()


def main():
    args = parse_args()
    if args.reader:
        run_reader(READER_ROOT)
        return 0
    if args.export:
        run_export(READER_ROOT, EXPORT_ROOT, args.export, *(args.rewrite or ("", "")))
        return 0
    if args.dump:
        run_dump(READER_ROOT, EXPORT_ROOT)
        return 0

    if args.migrate and args.host_only:
        fail("--migrate reads the volumes, so it cannot run with --host-only")

    volumes = []
    containers = {}
    if not args.host_only:
        volumes = [
            name
            for name in docker("volume", "ls", "--format", "{{.Name}}").split()
            if name.endswith(VOLUME_SUFFIX) and (not args.project or name.startswith(f"{args.project}-dev-"))
        ]
        containers = collect_containers()
    if args.migrate:
        return migrate(volumes, containers, args.claude_home, args.image, args.dry_run)

    scanned = merge_scans(
        scan_volumes(volumes, args.image) if volumes else {},
        scan_host_logs(args.claude_home),
    )
    if args.project:
        scanned = {k: v for k, v in scanned.items() if k.startswith(f"{args.project}-dev-")}
    if not scanned:
        print("no devcontainer session logs matched", file=sys.stderr)
        return 1

    # A session being copied out may well be one that was seeded in and then
    # continued, so --resume-on-host has to search the unfiltered set.
    include_seeded = args.all or bool(args.resume_on_host)
    rows = build_rows(scanned, containers, include_seeded, args.claude_home)
    if args.resume_on_host:
        return resume_on_host(
            select_session(rows, args.resume_on_host),
            args.claude_home,
            args.image,
            args.force,
            args.dry_run,
            args.container_workspace,
            args.worktree_path,
            args.host_only,
        )
    if args.worktree:
        rows = [row for row in rows if args.worktree in (row["worktree"] or row["worktree_slug"])]
    if not args.sidechains:
        rows = [row for row in rows if not row["sidechain"]]
    if args.limit:
        rows = rows[: args.limit]

    if args.json:
        json.dump(rows, sys.stdout, indent=2)
        print()
    else:
        print_table(rows, str(Path.home()))
    return 0


if __name__ == "__main__":
    sys.exit(main())
