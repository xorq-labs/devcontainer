#!/usr/bin/env bash
set -euo pipefail

# Bump the pinned kenn-io toolkit versions in nix/kenn/sources.json.
#
# Usage:
#   devcontainer bump-kenn                    # bump every tool to its latest release
#   devcontainer bump-kenn --tool kata kwt    # only these tools
#   devcontainer bump-kenn --pin kata=0.14.3  # hold one at an explicit version
#   devcontainer bump-kenn --check            # report committed vs latest, don't edit
#   devcontainer bump-kenn --verify           # gate the committed pins (CI)
#
# --check and --verify are not interchangeable, and follow the same split as
# bump-hadolint and bump-nix-base: --check is a report (drift is news, not a
# failure — exit 0 whether or not a newer release exists, non-zero only when a
# version could not be resolved at all), --verify is the gate (re-derives every
# committed version's hashes from the release's checksum manifest, non-zero on
# any mismatch or on an unreachable upstream).
#
# Unlike bump-claude-code there is no Dockerfile pin to edit: the toolkit is
# consumed from the nix/kenn flake (host direnv shells; optionally the Nix
# base). All pins — versions and per-platform SRI hashes — live in
# sources.json, and update.py derives the hashes from the releases' published
# checksum manifests without downloading any tarballs. It also handles the
# upstream inconsistencies (kwt's checksums.txt naming, forge's "./"-prefixed
# entries, kata's homebrew_* decoy assets); see nix/kenn/README.md.
#
# A separate --source mode (ADR-0007) builds select tools from a git revision
# instead of a release, pinned in nix/kenn/source-builds.json rather than
# sources.json:
#   devcontainer bump-kenn --source --tool kwt --rev main       # bump to a branch's HEAD
#   devcontainer bump-kenn --source --check --tool kwt --rev main
#   devcontainer bump-kenn --source --verify                    # rebuild every committed pin
# This mode needs a working `nix` on PATH — discovering a source-build hash
# means actually running `nix build`, there is no manifest to read it from.

base="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
updater="$base/nix/kenn/update.py"

[ -f "$updater" ] || { echo "error: $updater not found" >&2; exit 1; }
command -v python3 >/dev/null 2>&1 || { echo "error: python3 is required" >&2; exit 1; }

exec python3 "$updater" "$@"
