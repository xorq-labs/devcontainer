#!/usr/bin/env bash
set -euo pipefail

# Emit shell completions for `devcontainer`.
#
# Command names, their descriptions, and their argument wiring are GENERATED
# from lib/command-table.tsv — there is no hand-maintained per-shell command
# list here any more. To add a subcommand: add the dispatch arm in
# dev/devcontainer and add a row to the table. tests/test-completions-sync.sh
# guards the one pair that cannot be generated (dispatch arms == table names).
#
# Deliberately NOT table-driven (they are per-shell boilerplate with no
# per-command variation): the `-w/--workspace` global option, the subcommand
# scanner in the bash function, and each shell's framework preamble.
#
# The table is read at generation time only. `install-completions` and the Nix
# package redirect this script's stdout into a static file, so an installed
# completion script never reads the table (or this repo) again.

_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=../lib/command-table.sh
. "$_dir/../lib/command-table.sh"

shell="${1:-bash}"
case "$shell" in
    bash|zsh|fish) ;;
    *) echo "Unsupported shell: $shell (try bash, zsh, or fish)" >&2; exit 1 ;;
esac

# --- table load -------------------------------------------------------------

# arg-syntax and usage-desc are show_usage's columns; only the completion
# columns are kept here.
names=() types=() wordspecs=() labels=() shorts=()
_rows="$(command_table_rows)" || exit 1
while IFS=$'\t' read -r _name _syntax _type _words _label _short _usage; do
    [ -n "$_name" ] || continue
    names+=("$_name")
    types+=("$_type")
    wordspecs+=("$_words")
    labels+=("$_label")
    shorts+=("$_short")
done <<<"$_rows"

all_names="${names[*]}"

# --- escaping ---------------------------------------------------------------
#
# Descriptions are free prose from the table; they must survive the quoting of
# whichever shell consumes them. Do not rely on authoring discipline (the old
# hand-maintained fish list simply avoided apostrophes) — escape here.

# zsh `'name:description'`: `'` ends the quote, `:` separates the two fields.
zsh_escape() {
    local s="$1"
    s="${s//\'/\'\\\'\'}"
    s="${s//:/\\:}"
    printf '%s' "$s"
}

# fish `'...'`: single quotes take exactly two escapes, `\\` and `\'`.
fish_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\'/\\\'}"
    printf '%s' "$s"
}

# arg-words entries are `word[:description]`; the table validator has already
# rejected a second colon and any word that is not a plain flag/value.
spec_word() { printf '%s' "${1%%:*}"; }
spec_desc() { case "$1" in *:*) printf '%s' "${1#*:}" ;; *) : ;; esac; }

# Split a row's arg-words spec into the shared `entries` array.
entries=()
spec_entries() {
    entries=()
    [ "$1" != "-" ] || return 0
    IFS='|' read -r -a entries <<<"$1"
}

# Space-separated word list for a row's arg-words (empty when there are none).
row_words() {
    local out="" entry
    spec_entries "$1"
    for entry in "${entries[@]}"; do
        out+="${out:+ }$(spec_word "$entry")"
    done
    printf '%s' "$out"
}

# --- bash -------------------------------------------------------------------

emit_bash() {
    cat <<'BASH'
_devcontainer() {
    local cur prev words cword
    _init_completion || return

BASH
    printf '    local subcmds="%s"\n' "$all_names"
    cat <<'BASH'
    local global_opts="-w --workspace"

    local i=1 subcmd=""
    while [ $i -lt $cword ]; do
        case "${words[i]}" in
            -w|--workspace) ((i+=2)); continue ;;
            -*) ((i++)); continue ;;
            *) subcmd="${words[i]}"; break ;;
        esac
    done

    if [ -z "$subcmd" ]; then
        if [[ "$cur" == -* ]]; then
            COMPREPLY=($(compgen -W "$global_opts" -- "$cur"))
        elif [[ "$prev" == -w || "$prev" == --workspace ]]; then
            _filedir -d
        else
            COMPREPLY=($(compgen -W "$subcmds" -- "$cur"))
        fi
        return
    fi

    case "$subcmd" in
BASH
    local n words_list body
    for n in "${!names[@]}"; do
        body=""
        words_list="$(row_words "${wordspecs[$n]}")"
        [ -z "$words_list" ] || body+="            COMPREPLY=(\$(compgen -W \"$words_list\" -- \"\$cur\"))"$'\n'
        case "${types[$n]}" in
            file)    body+='            _filedir'$'\n' ;;
            dir)     body+='            _filedir -d'$'\n' ;;
            command) body+='            COMPREPLY=($(compgen -c -- "$cur"))'$'\n' ;;
        esac
        [ -n "$body" ] || continue
        printf '        %s)\n%s            ;;\n' "${names[$n]}" "$body"
    done
    cat <<'BASH'
    esac
}
BASH
    printf 'complete -F _devcontainer devcontainer\n'
}

# --- zsh --------------------------------------------------------------------

emit_zsh() {
    echo '#compdef devcontainer'
    echo '_devcontainer() {'
    echo '    local -a subcmds=('
    local n
    for n in "${!names[@]}"; do
        printf "        '%s:%s'\n" "${names[$n]}" "$(zsh_escape "${shorts[$n]}")"
    done
    cat <<'ZSH'
    )
    _arguments -s \
        '(-w --workspace)'{-w,--workspace}'[workspace directory]:dir:_directories' \
        '1:subcommand:->subcmd' \
        '*::arg:->args'
    case $state in
        subcmd) _describe 'subcommand' subcmds ;;
        args)
            case $words[1] in
ZSH
    local words_list label body
    for n in "${!names[@]}"; do
        body=""
        words_list="$(row_words "${wordspecs[$n]}")"
        label="${labels[$n]}"
        [ "$label" != "-" ] || label="arg"
        [ -z "$words_list" ] || body+=" _values '$(zsh_escape "$label")' $words_list ;"
        case "${types[$n]}" in
            file)    body+=' _files ;' ;;
            dir)     body+=' _files -/ ;' ;;
            command) body+=' _command_names ;' ;;
        esac
        [ -n "$body" ] || continue
        printf '                %s)%s;\n' "${names[$n]}" "$body"
    done
    cat <<'ZSH'
            esac
            ;;
    esac
}
_devcontainer "$@"
ZSH
}

# --- fish -------------------------------------------------------------------

emit_fish() {
    printf 'set -l cmds %s\n' "$all_names"
    printf 'complete -c devcontainer -f\n'
    local root='complete -c devcontainer -n "not __fish_seen_subcommand_from $cmds"'
    printf "%s -s w -l workspace -ra '(__fish_complete_directories)' -d 'workspace directory'\n" "$root"
    local n
    for n in "${!names[@]}"; do
        printf "%s -a %s -d '%s'\n" "$root" "${names[$n]}" "$(fish_escape "${shorts[$n]}")"
    done
    local sub entry word desc bare label
    for n in "${!names[@]}"; do
        sub="complete -c devcontainer -n \"__fish_seen_subcommand_from ${names[$n]}\""
        spec_entries "${wordspecs[$n]}"
        if [ "${#entries[@]}" -gt 0 ]; then
            # Bare words become plain argument candidates on one line; a word
            # that carries a description becomes a real fish option so the
            # description is shown.
            bare=""
            for entry in "${entries[@]}"; do
                desc="$(spec_desc "$entry")"
                [ -n "$desc" ] || bare+="${bare:+ }$(spec_word "$entry")"
            done
            [ -z "$bare" ] || printf "%s -a '%s'\n" "$sub" "$(fish_escape "$bare")"
            for entry in "${entries[@]}"; do
                desc="$(spec_desc "$entry")"
                [ -n "$desc" ] || continue
                word="$(spec_word "$entry")"
                case "$word" in
                    --?*) printf "%s -l %s -d '%s'\n" "$sub" "${word#--}" "$(fish_escape "$desc")" ;;
                    -?)   printf "%s -s %s -d '%s'\n" "$sub" "${word#-}" "$(fish_escape "$desc")" ;;
                    *)    printf "%s -a '%s' -d '%s'\n" "$sub" "$(fish_escape "$word")" "$(fish_escape "$desc")" ;;
                esac
            done
        fi
        label="${labels[$n]}"
        [ "$label" != "-" ] || label="argument"
        case "${types[$n]}" in
            file) printf "%s -F -d '%s'\n" "$sub" "$(fish_escape "$label")" ;;
            dir)  printf "%s -a '(__fish_complete_directories)' -d '%s'\n" "$sub" "$(fish_escape "$label")" ;;
            command) printf "%s -a '(__fish_complete_subcommand)'\n" "$sub" ;;
        esac
    done
}

case "$shell" in
    bash) emit_bash ;;
    zsh)  emit_zsh ;;
    fish) emit_fish ;;
esac
