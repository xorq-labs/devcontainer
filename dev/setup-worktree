#!/usr/bin/env bash
# Propagate files from the main checkout into a new worktree, per the project
# overlay's worktree-symlinks.txt / worktree-copies.txt (plus per-developer
# extras in the main checkout's .envrcs/.worktree-symlinks).
#
# Everything created is recorded in a manifest, .envrcs/.worktree-manifest,
# one "<action>\t<path>" line per entry (action = copy|symlink), which
# dev/cleanup-worktree replays to undo the setup. cleanup-worktree also still
# parses a LEGACY bare-path format (a line with no tab is treated as a path
# with an empty action) — so the manifest format cannot change without
# updating that reader in lockstep.
#
# Lifecycle: the manifest is truncated at the start of every run, then
# appended to as entries are (re)recorded. Callers that add their own entries
# must therefore re-append after this script returns — dev/devcontainer does
# exactly that for its .envrcs/.resolved-env entry in ensure_up().
#
# Two paths are handled outside the overlay lists:
#   .gitignore — always a copy: git opens it with O_NOFOLLOW, so a symlink
#                would ELOOP (falls back to .gitignore.template when the main
#                checkout has no live, per-checkout .gitignore).
#   .claude    — a real directory (git materializes it for tracked content
#                like .claude/agents/); only the shared-state subdirs
#                (container-audit/, container-sessions/) are symlinked so
#                audit logs and session captures aggregate in the main
#                checkout (ADR-0003). A pre-ADR-0003 whole-directory symlink
#                is left as-is (legacy layout).
set -euo pipefail

_base="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
. "$_base/lib/git.sh"
main=$(dev_main_tree)
here=$(git rev-parse --show-toplevel)

if [ "$main" = "$here" ]; then
    echo "Already in the main worktree, nothing to copy." >&2
    exit 0
fi

_project_dir="$(resolve_project_dir "$_base" "$main")"

manifest="$here/.envrcs/.worktree-manifest"
mkdir -p "$here/.envrcs"
: > "$manifest"
changes=0

. "$_base/lib/list-file.sh"

# `[ -e PATH ]` follows symlinks, so a broken symlink reads as "not present"
# and we'd try to create over it. `-L` catches the symlink itself.
is_present() { [ -e "$1" ] || [ -L "$1" ]; }

# Stale symlink (target gone) → remove so the create step below can heal it.
# Leaves real files/dirs and valid symlinks untouched. Returns 0 if healed.
heal_stale_symlink() {
    if [ -L "$1" ] && [ ! -e "$1" ]; then
        rm -v "$1"
        return 0
    fi
    return 1
}

# Copy paths listed in worktree-copies.txt (globs expanded against $main).
# NUL-delimited subshell with nullglob handles filenames with spaces safely.
# Shell substitutions (`$(...)`, backticks, `~`, `$VAR`) in patterns are not
# supported — the file is treated as data, not script.
while IFS= read -r pattern; do
    [ -z "$pattern" ] && continue
    while IFS= read -r -d '' f; do
        is_present "$f" || continue
        rel="${f#"$main/"}"
        if ! is_present "$here/$rel"; then
            mkdir -p "$here/$(dirname "$rel")"
            cp -Pv "$f" "$here/$rel"
            changes=$((changes + 1))
        fi
        printf 'copy\t%s\n' "$rel" >> "$manifest"
    done < <(shopt -s nullglob; IFS=; for f in "$main"/$pattern; do printf '%s\0' "$f"; done)
done < <(read_list "$_project_dir/worktree-copies.txt")

# .gitignore: git opens it with O_NOFOLLOW (a symlink would ELOOP) — must be a copy.
# The live .gitignore is untracked (per-checkout); .gitignore.template is its
# tracked source, so fall back to the template when the main checkout has no
# live file. Either way the worktree gets a plain `.gitignore` copy, recorded
# in the manifest identically.
_gitignore_src=""
if [ -e "$main/.gitignore" ]; then
    _gitignore_src="$main/.gitignore"
elif [ -e "$main/.gitignore.template" ]; then
    _gitignore_src="$main/.gitignore.template"
fi
if [ -n "$_gitignore_src" ]; then
    if ! is_present "$here/.gitignore"; then
        cp -v "$_gitignore_src" "$here/.gitignore"
        changes=$((changes + 1))
    fi
    printf 'copy\t%s\n' ".gitignore" >> "$manifest"
fi
# The copy above propagates the main checkout's live rules, drift included:
# warn — never block worktree creation — when the effective rules here break
# ADR-0003's re-inclusion. The commit-time pre-commit hook is the hard gate;
# this is the early signal at the moment a stale file would spread (#91).
"$_base/dev/check-gitignore-agents" "$here" \
    || echo "WARNING: continuing anyway; commits adding .claude/agents/ files will be blocked here until the live .gitignore is fixed (see above)." >&2

link_from_main() {
    local target="$1"
    heal_stale_symlink "$here/$target" && changes=$((changes + 1))
    if [ -e "$main/$target" ]; then
        if ! is_present "$here/$target"; then
            mkdir -p "$(dirname "$here/$target")"
            ln -sv "$main/$target" "$here/$target"
            changes=$((changes + 1))
        fi
        printf 'symlink\t%s\n' "$target" >> "$manifest"
    fi
}

# .claude: audit logs and session captures must aggregate in the main checkout
# (devcontainer infrastructure, not project-specific), but .claude/agents/ is
# tracked content that git materializes into the worktree — so .claude is a
# real directory and only the shared-state subdirs are symlinked (ADR-0003).
# A worktree from before ADR-0003 has a whole-directory symlink instead; keep
# it (legacy layout — the subdirs already resolve through it) and re-record it
# so cleanup-worktree still removes it. Migrate by deleting the symlink and
# re-running setup-worktree.
heal_stale_symlink "$here/.claude" && changes=$((changes + 1))
if [ -L "$here/.claude" ]; then
    printf 'symlink\t%s\n' ".claude" >> "$manifest"
else
    if [ ! -d "$here/.claude" ]; then
        mkdir -pv "$here/.claude"
        changes=$((changes + 1))
    fi
    for _sub in container-audit container-sessions; do
        mkdir -p "$main/.claude/$_sub"
        link_from_main ".claude/$_sub"
    done
fi

# Symlink paths listed in worktree-symlinks.txt (from the project overlay).
while IFS= read -r target; do
    [ -z "$target" ] && continue
    link_from_main "$target"
done < <(read_list "$_project_dir/worktree-symlinks.txt")

# Per-developer extras (gitignored).
while IFS= read -r target; do
    [ -z "$target" ] && continue
    link_from_main "$target"
done < <(read_list "$main/.envrcs/.worktree-symlinks")

if [ "$changes" -gt 0 ]; then
    echo "Manifest written to .envrcs/.worktree-manifest"
    echo "To remove: cleanup-worktree"
fi
