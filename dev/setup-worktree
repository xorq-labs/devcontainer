#!/usr/bin/env bash
# Propagate files from the main checkout into a new worktree, per the project
# overlay's worktree-symlinks.txt / worktree-copies.txt (plus per-developer
# extras in the main checkout's .envrcs/.worktree-symlinks).
#
# Everything created is recorded in a manifest, .envrcs/.worktree-manifest,
# one "<action>\t<path>" line per entry (action = copy|symlink), which
# dev/cleanup-worktree replays to undo the setup. cleanup-worktree also still
# parses a LEGACY bare-path format (a line with no tab is treated as a path
# with an empty action) — so the manifest format cannot change without
# updating that reader in lockstep.
#
# Lifecycle: the manifest is truncated at the start of every run, then
# appended to as entries are (re)recorded. Callers that add their own entries
# must therefore re-append after this script returns — dev/devcontainer does
# exactly that for its .envrcs/.resolved-env entry in ensure_up().
#
# Two paths are handled outside the overlay lists:
#   .gitignore — always a copy: git opens it with O_NOFOLLOW, so a symlink
#                would ELOOP (falls back to .gitignore.template when the main
#                checkout has no live, per-checkout .gitignore). A symlink to
#                main's file that a developer put there by hand is not
#                replaced, --refresh included; git warns it cannot read it.
#   .claude    — a real directory (git materializes it for tracked content
#                like .claude/agents/); only the shared-state subdirs
#                (container-audit/, container-sessions/) are symlinked so
#                audit logs and session captures aggregate in the main
#                checkout (ADR-0003). A pre-ADR-0003 whole-directory symlink
#                is left as-is (legacy layout).
#
# Copies are skip-if-present: a worktree keeps whatever it was given at
# creation, so a later edit to the main checkout's copy (a per-developer
# .envrc.user, a rotated encrypted secret) never reaches it. --refresh
# re-copies every copy entry whose worktree file differs from main's, after
# saving the old file under the worktree's git admin dir
# (<git-dir>/setup-worktree-backup/<timestamp>/<path>) — outside the work
# tree, so cleanup-worktree's pre-flight never sees it and `git worktree
# remove` deletes it with the rest of the admin dir. Paths tracked in the
# worktree are never overwritten. A copy that cannot be refreshed (an
# unreadable source) keeps its old file and makes the run exit 1. Only names
# are printed, never contents or diffs: the copy lists hold secrets.
#
# Upstream can start tracking a path a worktree already holds as a copy or a
# symlink. Taking that commit then fails one of two ways: git refuses the merge
# over an untracked path that is not ignored, and silently replaces one that
# is, local edits included. --pre-merge <ref> runs before the merge of <ref>
# (pull, rebase and checkout should behave alike; only merge is tested) and
# clears every untracked path <ref> tracks: a symlink into the main checkout,
# or a file identical to <ref>'s, is removed, since nothing is lost; anything
# else is moved to the same backup dir --refresh uses. It does not merge. It is
# a step the user runs first: no git hook suits (CLAUDE.md, the --pre-merge
# invariant).
# A path the worktree tracks is never recorded in the manifest, by --pre-merge
# or a plain run: cleanup-worktree restores a tracked `copy` entry with `git
# checkout --`, which would discard an edit to a file upstream now owns.
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: setup-worktree [--refresh]
       setup-worktree --pre-merge <ref>

Propagate overlay copies/symlinks from the main checkout into the current
worktree. Existing copies are left alone unless --refresh is given, which
re-copies those that differ from the main checkout's, backing up the old
file under the worktree's git admin dir.

--pre-merge <ref> prepares the worktree to take <ref> (merge, pull, rebase,
checkout): every untracked path <ref> tracks is removed when nothing is lost
(a symlink into the main checkout, a file identical to <ref>'s) and backed up
otherwise. Run it, then merge:

  git fetch && setup-worktree --pre-merge origin/main && git merge origin/main
USAGE
}

refresh=0
pre_merge=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --refresh) refresh=1 ;;
        --pre-merge)
            if [ "$#" -lt 2 ]; then
                echo "setup-worktree: --pre-merge needs a ref" >&2
                usage >&2
                exit 2
            fi
            pre_merge="$2"
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "setup-worktree: unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done
if [ "$refresh" -eq 1 ] && [ -n "$pre_merge" ]; then
    echo "setup-worktree: --refresh and --pre-merge are separate runs" >&2
    exit 2
fi

_base="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
. "$_base/lib/git.sh"
main=$(dev_main_tree)
here=$(git rev-parse --show-toplevel)

if [ "$main" = "$here" ]; then
    echo "Already in the main worktree, nothing to copy." >&2
    exit 0
fi

_project_dir="$(resolve_project_dir "$_base" "$main")"

manifest="$here/.envrcs/.worktree-manifest"
changes=0

. "$_base/lib/list-file.sh"

# `[ -e PATH ]` follows symlinks, so a broken symlink reads as "not present"
# and we'd try to create over it. `-L` catches the symlink itself.
is_present() { [ -e "$1" ] || [ -L "$1" ]; }

# Stale symlink (target gone) → remove so the create step below can heal it.
# Leaves real files/dirs and valid symlinks untouched. Returns 0 if healed.
heal_stale_symlink() {
    if [ -L "$1" ] && [ ! -e "$1" ]; then
        rm -v "$1"
        return 0
    fi
    return 1
}

# Same content as main's copy would produce: `cp -P` keeps a symlink as a
# symlink, so compare link targets for those and bytes for regular files.
same_copy() {
    local src="$1" dst="$2"
    if [ -L "$src" ] || [ -L "$dst" ]; then
        [ -L "$src" ] && [ -L "$dst" ] && [ "$(readlink "$src")" = "$(readlink "$dst")" ]
    else
        cmp -s "$src" "$dst"
    fi
}

# A real directory, not a symlink to one: `cp -P` copies a symlink to a
# directory as a link, so that is a copy entry like any other.
is_real_dir() { [ ! -L "$1" ] && [ -d "$1" ]; }

# Tracked in this worktree's index (a directory counts if anything under it is).
is_tracked() { git -C "$here" ls-files --error-unmatch -- "$1" >/dev/null 2>&1; }

_backup_root=""
# Move $1 (relative to the worktree) under this run's backup set.
backup_path() {
    local rel="$1"
    if [ -z "$_backup_root" ]; then
        _backup_root="$(git -C "$here" rev-parse --absolute-git-dir)/setup-worktree-backup/$(date +%Y%m%dT%H%M%S)"
    fi
    mkdir -p "$_backup_root/$(dirname "$rel")"
    mv "$here/$rel" "$_backup_root/$rel"
}
refresh_failed=0
refresh_suffix=".setup-worktree-refresh"
# A temp file refresh_copy left behind (a run killed between its two renames).
# Swept for every copy entry on every run, before anything is copied: a stale
# temp that is a symlink would otherwise make `cp -P` write through it.
drop_refresh_tmp() {
    local tmp="$here/$1$refresh_suffix"
    if [ -L "$tmp" ] || [ -f "$tmp" ]; then rm -f "$tmp"; fi
}
# --refresh only: replace an existing copy at $2 (relative to the worktree)
# with $1 when they differ. Skips directories, paths the worktree tracks, and
# a worktree path that already resolves to main's file (a symlink into main).
# The new copy is written beside the old one first, so a source that cannot
# be read leaves the old copy in place rather than only in the backup.
refresh_copy() {
    local src="$1" rel="$2" dst="$here/$2"
    local tmp="$dst$refresh_suffix"
    [ "$refresh" -eq 1 ] || return 0
    is_real_dir "$src" || is_real_dir "$dst" && return 0
    [ "$src" -ef "$dst" ] && return 0
    same_copy "$src" "$dst" && return 0
    if ! cp -P "$src" "$tmp"; then
        rm -f "$tmp"
        echo "setup-worktree: could not refresh $rel; kept the existing copy" >&2
        refresh_failed=$((refresh_failed + 1))
        return 0
    fi
    backup_path "$rel"
    mv "$tmp" "$dst"
    echo "refreshed $rel (previous copy: $_backup_root/$rel)"
    changes=$((changes + 1))
}

# --pre-merge: the untracked path that stops <ref>'s $1 landing — $1 itself, or
# the first ancestor that is a file or a symlink (a symlinked directory: git
# never writes through one). Fails when nothing untracked is in the way.
merge_blocker() {
    local path="$1" prefix="" rest="$1"
    while :; do
        prefix="${prefix:+$prefix/}${rest%%/*}"
        if [ -L "$here/$prefix" ] || { [ -e "$here/$prefix" ] && { [ "$prefix" = "$path" ] || [ ! -d "$here/$prefix" ]; }; }; then
            is_tracked "$prefix" && return 1
            printf '%s' "$prefix"
            return 0
        fi
        [ -e "$here/$prefix" ] && [ "$prefix" != "$path" ] || return 1
        rest="${rest#*/}"
    done
}

# --pre-merge: whether the worktree's $2 already is <ref>'s $2, so removing it
# loses nothing. Content and link target only; a mode bit is not worth a backup.
same_as_ref() {
    local ref="$1" rel="$2" mode sha
    read -r mode _ sha _ < <(git -C "$here" ls-tree "$ref" -- "$rel")
    case "$mode" in
        120000) [ -L "$here/$rel" ] && [ "$(readlink "$here/$rel")" = "$(git -C "$here" cat-file blob "$sha")" ] ;;
        100644 | 100755) [ ! -L "$here/$rel" ] && [ -f "$here/$rel" ] \
            && [ "$(git -C "$here" hash-object -- "$rel")" = "$sha" ] ;;
        *) return 1 ;;
    esac
}

if [ -n "$pre_merge" ]; then
    if ! _ref="$(git -C "$here" rev-parse --verify --quiet "$pre_merge^{commit}")"; then
        echo "setup-worktree: --pre-merge: not a commit: $pre_merge" >&2
        exit 2
    fi
    declare -A _cleared=()
    # Paths <ref> tracks that the index does not: only those can be in the way.
    while IFS= read -r -d '' _path; do
        _blocker="$(merge_blocker "$_path")" || continue
        [[ -v _cleared["$_blocker"] ]] && continue
        _cleared["$_blocker"]=1
        if [ -L "$here/$_blocker" ] && [[ "$(readlink -f "$here/$_blocker")" == "$main/"* ]]; then
            rm "$here/$_blocker"
            echo "removed $_blocker (a link into the main checkout)"
        elif [ "$_blocker" = "$_path" ] && same_as_ref "$_ref" "$_path"; then
            rm "$here/$_blocker"
            echo "removed $_blocker (identical to $pre_merge)"
        else
            backup_path "$_blocker"
            echo "backed up $_blocker (now: $_backup_root/$_blocker)"
        fi
    done < <(comm -z -23 \
        <(git -C "$here" ls-tree -r -z --name-only "$_ref" | sort -z) \
        <(git -C "$here" ls-files -z | sort -z))
    # The merge makes these tracked; drop them (and anything under them) from
    # the manifest so cleanup-worktree leaves them to git.
    if [ "${#_cleared[@]}" -gt 0 ] && [ -f "$manifest" ]; then
        while IFS= read -r _line; do
            _ent="${_line#*$'\t'}"
            for _c in "${!_cleared[@]}"; do
                [[ "$_ent" == "$_c" || "$_ent" == "$_c/"* ]] && continue 2
            done
            printf '%s\n' "$_line"
        done < "$manifest" > "$manifest.tmp"
        mv "$manifest.tmp" "$manifest"
    fi
    exit 0
fi

mkdir -p "$here/.envrcs"
: > "$manifest"

# Copy paths listed in worktree-copies.txt (globs expanded against $main).
# NUL-delimited subshell with nullglob handles filenames with spaces safely.
# Shell substitutions (`$(...)`, backticks, `~`, `$VAR`) in patterns are not
# supported — the file is treated as data, not script.
while IFS= read -r pattern; do
    [ -z "$pattern" ] && continue
    while IFS= read -r -d '' f; do
        is_present "$f" || continue
        rel="${f#"$main/"}"
        drop_refresh_tmp "$rel"
        is_tracked "$rel" && continue
        if ! is_present "$here/$rel"; then
            mkdir -p "$here/$(dirname "$rel")"
            cp -Pv "$f" "$here/$rel"
            changes=$((changes + 1))
        else
            refresh_copy "$f" "$rel"
        fi
        printf 'copy\t%s\n' "$rel" >> "$manifest"
    done < <(shopt -s nullglob; IFS=; for f in "$main"/$pattern; do printf '%s\0' "$f"; done)
done < <(read_list "$_project_dir/worktree-copies.txt")

# .gitignore: git opens it with O_NOFOLLOW (a symlink would ELOOP) — must be a copy.
# The live .gitignore is untracked (per-checkout); .gitignore.template is its
# tracked source, so fall back to the template when the main checkout has no
# live file. Either way the worktree gets a plain `.gitignore` copy, recorded
# in the manifest identically.
_gitignore_src=""
if [ -e "$main/.gitignore" ]; then
    _gitignore_src="$main/.gitignore"
elif [ -e "$main/.gitignore.template" ]; then
    _gitignore_src="$main/.gitignore.template"
fi
if [ -n "$_gitignore_src" ]; then
    drop_refresh_tmp ".gitignore"
    if is_tracked .gitignore; then
        :
    elif ! is_present "$here/.gitignore"; then
        cp -v "$_gitignore_src" "$here/.gitignore"
        changes=$((changes + 1))
        printf 'copy\t%s\n' ".gitignore" >> "$manifest"
    else
        refresh_copy "$_gitignore_src" ".gitignore"
        printf 'copy\t%s\n' ".gitignore" >> "$manifest"
    fi
fi
# The copy above propagates the main checkout's live rules, drift included:
# warn — never block worktree creation — when the effective rules here break
# ADR-0003's re-inclusion. The commit-time pre-commit hook is the hard gate;
# this is the early signal at the moment a stale file would spread (#91).
# Only in repos where ADR-0003's convention is actually in force. setup-worktree
# runs on every `devcontainer up` in a non-main worktree for ANY project, and a
# consumer repo that simply ignores .claude/ is not broken — it made a different
# choice. Warning there was per-start noise, and its "commits will be blocked"
# line was false: the hard gate is this repo's .pre-commit-config.yaml, which
# consumer repos do not have.
if [ -n "$(git -C "$here" ls-files -- .claude/agents 2>/dev/null)" ]; then
    "$_base/dev/check-gitignore-agents" "$here" \
        || echo "WARNING: continuing anyway; commits adding .claude/agents/ files will be blocked here until the live .gitignore is fixed (see above)." >&2
fi

link_from_main() {
    local target="$1"
    heal_stale_symlink "$here/$target" && changes=$((changes + 1))
    is_tracked "$target" && return 0
    if [ -e "$main/$target" ]; then
        if ! is_present "$here/$target"; then
            mkdir -p "$(dirname "$here/$target")"
            ln -sv "$main/$target" "$here/$target"
            changes=$((changes + 1))
        fi
        printf 'symlink\t%s\n' "$target" >> "$manifest"
    fi
}

# .claude: audit logs and session captures must aggregate in the main checkout
# (devcontainer infrastructure, not project-specific), but .claude/agents/ is
# tracked content that git materializes into the worktree — so .claude is a
# real directory and only the shared-state subdirs are symlinked (ADR-0003).
# A worktree from before ADR-0003 has a whole-directory symlink instead; keep
# it (legacy layout — the subdirs already resolve through it) and re-record it
# so cleanup-worktree still removes it. Migrate by deleting the symlink and
# re-running setup-worktree.
heal_stale_symlink "$here/.claude" && changes=$((changes + 1))
if [ -L "$here/.claude" ]; then
    printf 'symlink\t%s\n' ".claude" >> "$manifest"
else
    if [ ! -d "$here/.claude" ]; then
        mkdir -pv "$here/.claude"
        changes=$((changes + 1))
    fi
    for _sub in container-audit container-sessions; do
        mkdir -p "$main/.claude/$_sub"
        link_from_main ".claude/$_sub"
    done
fi

# Symlink paths listed in worktree-symlinks.txt (from the project overlay).
while IFS= read -r target; do
    [ -z "$target" ] && continue
    link_from_main "$target"
done < <(read_list "$_project_dir/worktree-symlinks.txt")

# Per-developer extras (gitignored).
while IFS= read -r target; do
    [ -z "$target" ] && continue
    link_from_main "$target"
done < <(read_list "$main/.envrcs/.worktree-symlinks")

if [ "$changes" -gt 0 ]; then
    echo "Manifest written to .envrcs/.worktree-manifest"
    echo "To remove: cleanup-worktree"
fi
if [ "$refresh_failed" -gt 0 ]; then
    echo "setup-worktree: $refresh_failed cop(ies) could not be refreshed (see above)" >&2
    exit 1
fi
