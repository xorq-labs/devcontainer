# devcontainer per-user overrides (not committed)
.gitignore
project.env
host-mounts.local.txt

# python bytecode
__pycache__/
*.pyc

# direnv user/secrets (templates are tracked)
.envrcs/.envrc.user
.envrcs/.envrc.secrets
.envrcs/.resolved-env
.envrcs/.worktree-manifest
.envrcs/.worktree-symlinks

# Claude Code state is per-checkout/shared runtime data, but .claude/agents/
# is tracked content (ADR-0003). `.claude/*` (not bare `.claude`: a pattern
# matching the directory itself blocks every re-inclusion inside it) ignores
# the state; the negation lets tracked agent definitions back in.
.claude/*
!.claude/agents/
.tools

# nix build output symlink (nix/base: `nix build .#defaultBase`)
nix/base/result
nix/base/result-*
