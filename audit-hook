#!/usr/bin/env python3
"""Claude Code PreToolUse audit hook.

setup-claude.py installs this into the container's Claude settings as a
PreToolUse hook with an empty matcher (every tool), invoked as
`python3 /usr/local/bin/audit-hook <log>`. Each tool invocation appends one
JSON line ({ts, tool, input}) to .claude/container-audit/audit.jsonl in the
workspace. Review the log with `devcontainer audit`, which runs
audit-report.py.

Failures never block the tool call: any exception is appended to the
sibling .errors file and the hook exits 0.
"""

import json
import sys
from datetime import UTC, datetime
from pathlib import Path

log_path = sys.argv[1]
err_path = Path(log_path).with_suffix(".errors")

try:
    event = json.load(sys.stdin)
    entry = {
        "ts": datetime.now(UTC).isoformat(),
        "tool": event.get("tool_name", ""),
        "input": event.get("tool_input", {}),
    }
    with open(log_path, "a") as f:
        json.dump(entry, f, separators=(",", ":"))
        f.write("\n")
except Exception as exc:
    with open(err_path, "a") as f:
        f.write(f"{datetime.now(UTC).isoformat()} {exc}\n")
