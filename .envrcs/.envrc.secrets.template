# Per-user secrets (gitignored, never committed).
# Copy to .envrc.secrets. Secret values go in sops-encrypted dotenv bundles
# loaded with `use sops_if_exists`, never as a plain export here: this file is
# plaintext on disk. Bundle paths are relative to .envrcs/.
source_env .envrc.sops

# KATA_TEAM_TOKEN: your kata identity token, for .envrc.kata (ADR-0008); the
# server address goes in .env.local as KATA_TEAM_SERVER. The bundle is
# per-user, gitignored (.envrcs/.env.*) and copied into new worktrees. Create
# it from .envrcs/ without writing the token to disk:
#   read -rs KATA_TEAM_TOKEN
#   printf 'KATA_TEAM_TOKEN=%s\n' "$KATA_TEAM_TOKEN" | sops --encrypt \
#     --input-type dotenv --output-type dotenv --age <your age recipient> \
#     /dev/stdin > .env.kata.sops-encrypted
#   unset KATA_TEAM_TOKEN
# Your recipient comes from your age key; with none yet, create one where sops
# looks by default (the container sees it too: docker-compose.yml mounts that
# directory read-only):
#   mkdir -p ~/.config/sops/age && age-keygen -o ~/.config/sops/age/keys.txt
#   age-keygen -y ~/.config/sops/age/keys.txt    # prints the recipient
use sops_if_exists .env.kata.sops-encrypted
