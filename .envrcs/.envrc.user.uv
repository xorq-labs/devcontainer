export UV_TOOL_DIR="${direnv_root}/.tools/uvx"
export UV_TOOL_BIN_DIR="${direnv_root}/.tools/bin"
PATH_add "${direnv_root}/.tools/bin"

# CLAUDE.md's `uv tool install pre-commit` setup step is easy to skip on a
# fresh checkout, and dev/hooks/pre-commit then silently falls back to
# whatever pre-commit is on PATH (a container's, a nix profile's, ...) —
# untested against this repo and possibly missing fixes this repo relies on.
# Re-checked on every direnv reload; cheap once installed (`--version` only).
#
# Host only. The main checkout is bind-mounted into containers at its host
# path, and the uv shim's interpreter symlink dangles there (CLAUDE.md,
# "Pre-commit hooks") — so the probe below always fails inside a container,
# and installing from there would rewrite the SHARED .tools/uvx tree with
# container-side paths, breaking it for the host in the other direction.
if [ ! -e /.dockerenv ] && ! "${direnv_root}/.tools/bin/pre-commit" --version >/dev/null 2>&1; then
    if ! command -v uv >/dev/null 2>&1; then
        log_error "uv not found — install it, then run 'uv tool install pre-commit'"
    elif [ -e "${direnv_root}/.tools/bin/pre-commit" ]; then
        # Present but unrunnable — a stale venv from a moved or removed
        # interpreter. A plain `uv tool install` no-ops on an already-installed
        # tool, so it would leave the broken shim in place forever.
        uv tool install --reinstall pre-commit
    else
        uv tool install pre-commit
    fi
fi

# Install git hooks as a side effect of `direnv allow`: symlink_hooks (see
# lib/git.sh) links each dev/hooks/* file — notably the custom pre-commit
# wrapper — into .git/hooks. Idempotent: it only touches hooks that are
# missing or already symlinks, never a real file someone placed there.
# This is the installation step CLAUDE.md refers to when it says never to
# run `pre-commit install` — that would replace the symlinked custom hook
# with pre-commit's own stub.
(source "${direnv_root}/lib/git.sh" && symlink_hooks "${direnv_root}")
