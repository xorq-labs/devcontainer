# Per-user direnv overrides (gitignored).
# Copy to .envrc.user and customize.

source_env .envrc.user.uv
# source_env .envrc.user.kenn   # opt-in: kenn-io toolkit + shared worktree state

dotenv_if_exists .env.local
# source_env .envrc.kata        # opt-in: kata talks to the team server (after .env.local)

# This checkout's own dev/, not ../devcontainer/dev: from a worktree that
# names the MAIN checkout's scripts. Shadows an installed nix package on
# purpose, so you run the branch you are editing. Other projects get dev/ from
# the package or a sibling clone (README, "Adapting to another project").
PATH_add $direnv_root/dev
