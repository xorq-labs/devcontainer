# Copy to project.env (gitignored) to override defaults.
# PROJECT_NAME cannot be set here: it is resolved before this file is read
# (from the main checkout's basename, or DEV_PROJECT_NAME if set).
# MODEL_VERSION pins the Claude model used inside the container.
# MODEL_VERSION=claude-opus-4-7
# DANGEROUSLY_SKIP_PERMISSIONS=1 makes `dev/devcontainer claude` pass
# --dangerously-skip-permissions automatically.
# DANGEROUSLY_SKIP_PERMISSIONS=1
